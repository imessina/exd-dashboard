# Backend (FastAPI)
DATABASE_URL=postgresql://user:password@localhost:5432/exd_control
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Keys de acceso a la API (obligatorias en producción, opcionales en local).
# Genera valores largos y aleatorios, ej: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
ADMIN_API_KEY=

# Frontend (Vite/React)
VITE_API_URL=http://localhost:8000
# Misma key que API_KEY del backend; en producción se define en Vercel.
VITE_API_KEY=
